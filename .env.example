# Copy to .env and adjust. All variables are optional; defaults are safe for local use.

# Invoices at or above this amount (in cents) are routed for extra approval.
IQ_APPROVAL_LIMIT_CENTS=500000

# Expected sales-tax rate (as a fraction) and the tolerance within which an
# invoice's implied tax rate is considered normal.
IQ_EXPECTED_TAX_RATE=0.19
IQ_TAX_RATE_TOLERANCE=0.03

# Rounding tolerance in cents when checking that amounts add up (handles
# legitimate per-line rounding).
IQ_ARITHMETIC_TOLERANCE_CENTS=2

# Confidence below which the line-item categoriser routes to manual review.
IQ_CATEGORISER_MIN_CONFIDENCE=0.45
